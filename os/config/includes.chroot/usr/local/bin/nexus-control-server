#!/usr/bin/env python3
"""Nexus OS local control plane and web server.

The service intentionally uses only Python's standard library so the live
image remains small and can operate without an external control service.
"""

from __future__ import annotations

import json
import mimetypes
import os
import re
import shutil
import signal
import socket
import subprocess
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path


HOST = os.environ.get("NEXUS_CONTROL_HOST", "127.0.0.1")
PORT = int(os.environ.get("NEXUS_CONTROL_PORT", "4173"))
ROOT = Path(os.environ.get("MINECRAFT_SERVER_ROOT", "/srv/minecraft"))
DATA = Path(os.environ.get("NEXUS_DATA_DIR", "/var/lib/nexus"))
STATIC = Path(os.environ.get("NEXUS_STATIC_ROOT", "/opt/nexus-control"))
SERVERS_FILE = DATA / "servers.json"
MANIFEST_URL = "https://piston-meta.mojang.com/mc/game/version_manifest_v2.json"

STORE_LOCK = threading.RLock()
PROCESS_LOCK = threading.RLock()
PROCESSES: dict[str, tuple[subprocess.Popen[str], object]] = {}


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat()


def ensure_dirs() -> None:
    ROOT.mkdir(parents=True, exist_ok=True)
    DATA.mkdir(parents=True, exist_ok=True)
    if not SERVERS_FILE.exists():
        SERVERS_FILE.write_text("[]\n", encoding="utf-8")


def load_servers() -> list[dict]:
    with STORE_LOCK:
        try:
            value = json.loads(SERVERS_FILE.read_text(encoding="utf-8"))
            return value if isinstance(value, list) else []
        except (OSError, json.JSONDecodeError):
            return []


def save_servers(servers: list[dict]) -> None:
    with STORE_LOCK:
        temporary = SERVERS_FILE.with_suffix(".tmp")
        temporary.write_text(json.dumps(servers, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        temporary.replace(SERVERS_FILE)


def slugify(value: str) -> str:
    result = re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
    return result[:48] or "server"


def clean_name(value: object) -> str:
    name = str(value or "").strip()
    if not name or len(name) > 80:
        raise ValueError("El nombre debe tener entre 1 y 80 caracteres.")
    return name


def parse_port(value: object) -> int:
    try:
        port = int(value)
    except (TypeError, ValueError) as exc:
        raise ValueError("El puerto no es válido.") from exc
    if not 1024 <= port <= 65535:
        raise ValueError("El puerto debe estar entre 1024 y 65535.")
    return port


def clean_domain(value: object) -> str:
    domain = str(value or "").strip().lower()
    if not domain:
        return ""
    if len(domain) > 253 or not re.fullmatch(r"[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?", domain):
        raise ValueError("El dominio no es válido. Usa, por ejemplo, mc.ejemplo.com.")
    return domain


def clean_memory(value: object) -> str:
    memory = str(value or "2G").strip().upper()
    if not re.fullmatch(r"[1-9][0-9]*(?:M|G)", memory):
        raise ValueError("La memoria debe tener formato como 2G o 1536M.")
    return memory


def local_ips() -> list[str]:
    addresses = {"127.0.0.1"}
    try:
        for item in socket.getaddrinfo(socket.gethostname(), None, socket.AF_INET):
            addresses.add(item[4][0])
    except socket.gaierror:
        pass
    try:
        probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        probe.connect(("1.1.1.1", 53))
        addresses.add(probe.getsockname()[0])
        probe.close()
    except OSError:
        pass
    return sorted(addresses, key=lambda value: (value == "127.0.0.1", value))


def resolve_domain(domain: str) -> list[str]:
    if not domain:
        return []
    try:
        return sorted({item[4][0] for item in socket.getaddrinfo(domain, None, socket.AF_INET)})
    except socket.gaierror:
        return []


def read_pid(server_id: str) -> int | None:
    path = DATA / f"{server_id}.pid"
    try:
        return int(path.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return None


def remove_pid(server_id: str) -> None:
    try:
        (DATA / f"{server_id}.pid").unlink()
    except FileNotFoundError:
        pass


def process_for(server_id: str) -> subprocess.Popen[str] | None:
    with PROCESS_LOCK:
        entry = PROCESSES.get(server_id)
        if entry:
            process = entry[0]
            if process.poll() is None:
                return process
            PROCESSES.pop(server_id, None)
            remove_pid(server_id)
    pid = read_pid(server_id)
    if pid:
        try:
            os.kill(pid, 0)
            return None
        except OSError:
            remove_pid(server_id)
    return None


def server_status(server: dict) -> str:
    if process_for(server["id"]):
        return "online"
    pid = read_pid(server["id"])
    if pid:
        try:
            os.kill(pid, 0)
            return "online"
        except OSError:
            remove_pid(server["id"])
    return "offline"


def server_view(server: dict) -> dict:
    directory = Path(server["directory"])
    jar_path = directory / server.get("jar", "server.jar")
    status = server_status(server)
    ips = local_ips()
    domain = server.get("domain", "")
    resolved = resolve_domain(domain)
    return {
        **server,
        "status": status,
        "jar_present": jar_path.is_file(),
        "ready": jar_path.is_file() and bool(server.get("eula")),
        "pid": read_pid(server["id"]) if status == "online" else None,
        "connection": {
            "domain": f"{domain}:{server['port']}" if domain else "",
            "ips": [f"{ip}:{server['port']}" for ip in ips],
            "resolved_ips": resolved,
            "domain_resolves": bool(resolved) if domain else None,
        },
    }


def find_server(servers: list[dict], server_id: str) -> dict:
    for server in servers:
        if server["id"] == server_id:
            return server
    raise KeyError(server_id)


def update_properties(directory: Path, values: dict[str, str]) -> None:
    path = directory / "server.properties"
    current: dict[str, str] = {}
    if path.exists():
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            if "=" in line and not line.startswith("#"):
                key, value = line.split("=", 1)
                current[key] = value
    current.update(values)
    path.write_text("\n".join(f"{key}={value}" for key, value in sorted(current.items())) + "\n", encoding="utf-8")


def fetch_json(url: str) -> dict:
    request = urllib.request.Request(url, headers={"User-Agent": "NexusOS/0.2"})
    with urllib.request.urlopen(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))


def version_download(version: str) -> tuple[str, str]:
    manifest = fetch_json(MANIFEST_URL)
    selected = version.strip()
    if selected in ("latest", ""):
        selected = manifest["latest"]["release"]
    for item in manifest.get("versions", []):
        if item.get("id") == selected:
            metadata = fetch_json(item["url"])
            download = metadata.get("downloads", {}).get("server", {}).get("url")
            if download:
                return selected, download
            break
    raise ValueError(f"No existe una descarga oficial para la versión {selected}.")


def download_jar(url: str, destination: Path) -> None:
    parsed = urllib.parse.urlparse(url)
    if parsed.scheme not in {"http", "https"}:
        raise ValueError("La URL del JAR debe comenzar por http:// o https://.")
    request = urllib.request.Request(url, headers={"User-Agent": "NexusOS/0.2"})
    temporary = destination.with_suffix(".download")
    try:
        with urllib.request.urlopen(request, timeout=120) as response, temporary.open("wb") as output:
            shutil.copyfileobj(response, output)
        if temporary.stat().st_size < 1024 * 1024:
            raise ValueError("La descarga no parece ser un JAR de Minecraft válido.")
        temporary.replace(destination)
    finally:
        if temporary.exists():
            temporary.unlink()


def create_server(payload: dict) -> dict:
    name = clean_name(payload.get("name"))
    port = parse_port(payload.get("port", 25565))
    domain = clean_domain(payload.get("domain"))
    memory = clean_memory(payload.get("memory", "2G"))
    eula = bool(payload.get("eula"))
    version = str(payload.get("version") or "latest").strip()
    jar_url = str(payload.get("jar_url") or "").strip()
    servers = load_servers()
    if any(item["port"] == port for item in servers):
        raise ValueError(f"El puerto {port} ya está asignado a otro servidor.")
    base_id = slugify(name)
    server_id = base_id
    suffix = 2
    while any(item["id"] == server_id for item in servers):
        server_id = f"{base_id}-{suffix}"
        suffix += 1
    directory = ROOT / server_id
    directory.mkdir(parents=True, exist_ok=False)
    jar_name = "server.jar"
    try:
        if not jar_url:
            version, jar_url = version_download(version)
        download_jar(jar_url, directory / jar_name)
        update_properties(directory, {
            "enable-query": "false",
            "eula": "false",
            "max-players": "20",
            "motd": f"Nexus OS - {name}",
            "online-mode": "true",
            "server-ip": "",
            "server-port": str(port),
            "view-distance": "10",
        })
        (directory / "eula.txt").write_text(f"eula={str(eula).lower()}\n", encoding="utf-8")
        server = {
            "id": server_id,
            "name": name,
            "version": version,
            "port": port,
            "domain": domain,
            "memory": memory,
            "jar": jar_name,
            "directory": str(directory),
            "eula": eula,
            "created_at": utc_now(),
        }
        (directory / "nexus.json").write_text(json.dumps(server, indent=2) + "\n", encoding="utf-8")
        servers.append(server)
        save_servers(servers)
        return server_view(server)
    except Exception:
        shutil.rmtree(directory, ignore_errors=True)
        raise


def start_server(server: dict) -> dict:
    if server_status(server) == "online":
        return server_view(server)
    if not server.get("eula"):
        raise ValueError("Debes aceptar la EULA de Minecraft antes de iniciar el servidor.")
    directory = Path(server["directory"])
    jar_path = directory / server.get("jar", "server.jar")
    if not jar_path.is_file():
        raise ValueError("Falta el JAR del servidor.")
    log_path = directory / "nexus.log"
    log_file = log_path.open("a", encoding="utf-8")
    command = ["java", f"-Xms512M", f"-Xmx{server['memory']}", "-jar", jar_path.name, "nogui"]
    try:
        process = subprocess.Popen(
            command,
            cwd=directory,
            stdin=subprocess.PIPE,
            stdout=log_file,
            stderr=subprocess.STDOUT,
            text=True,
            start_new_session=True,
        )
    except Exception:
        log_file.close()
        raise
    with PROCESS_LOCK:
        PROCESSES[server["id"]] = (process, log_file)
    (DATA / f"{server['id']}.pid").write_text(str(process.pid), encoding="utf-8")
    return server_view(server)


def stop_server(server: dict) -> dict:
    server_id = server["id"]
    with PROCESS_LOCK:
        entry = PROCESSES.get(server_id)
    process = entry[0] if entry else None
    pid = process.pid if process else read_pid(server_id)
    if not pid:
        return server_view(server)
    if process and process.stdin:
        try:
            process.stdin.write("stop\n")
            process.stdin.flush()
        except OSError:
            pass
    deadline = time.time() + 20
    while time.time() < deadline:
        if process and process.poll() is not None:
            break
        try:
            os.kill(pid, 0)
        except OSError:
            break
        time.sleep(0.5)
    try:
        os.killpg(pid, signal.SIGTERM)
    except OSError:
        pass
    with PROCESS_LOCK:
        entry = PROCESSES.pop(server_id, None)
        if entry:
            entry[1].close()
    remove_pid(server_id)
    return server_view(server)


class NexusHandler(BaseHTTPRequestHandler):
    server_version = "NexusOS/0.2"

    def log_message(self, format: str, *args: object) -> None:
        print(f"{self.address_string()} - {format % args}", flush=True)

    def send_json(self, payload: object, status: int = HTTPStatus.OK) -> None:
        body = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def send_error_json(self, message: str, status: int = HTTPStatus.BAD_REQUEST) -> None:
        self.send_json({"error": message}, status)

    def read_payload(self) -> dict:
        length = int(self.headers.get("Content-Length", "0"))
        if length > 1024 * 1024:
            raise ValueError("La petición es demasiado grande.")
        if not length:
            return {}
        value = json.loads(self.rfile.read(length).decode("utf-8"))
        return value if isinstance(value, dict) else {}

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path.startswith("/api/"):
            self.api_get(parsed.path)
            return
        self.static_file(parsed.path)

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        if not parsed.path.startswith("/api/"):
            self.send_error_json("Ruta no disponible.", HTTPStatus.NOT_FOUND)
            return
        try:
            payload = self.read_payload()
            self.api_post(parsed.path, payload)
        except KeyError:
            self.send_error_json("Servidor no encontrado.", HTTPStatus.NOT_FOUND)
        except ValueError as exc:
            self.send_error_json(str(exc))
        except (OSError, urllib.error.URLError) as exc:
            self.send_error_json(f"No se pudo completar la operación: {exc}", HTTPStatus.BAD_GATEWAY)
        except Exception as exc:
            self.send_error_json(f"Error interno: {exc}", HTTPStatus.INTERNAL_SERVER_ERROR)

    def static_file(self, path: str) -> None:
        relative = "index.html" if path in {"", "/"} else path.lstrip("/")
        candidate = (STATIC / relative).resolve()
        if STATIC.resolve() not in candidate.parents and candidate != STATIC.resolve():
            self.send_error_json("Ruta no disponible.", HTTPStatus.NOT_FOUND)
            return
        if not candidate.is_file():
            self.send_error_json("Archivo no encontrado.", HTTPStatus.NOT_FOUND)
            return
        body = candidate.read_bytes()
        self.send_response(HTTPStatus.OK)
        self.send_header("Content-Type", mimetypes.guess_type(str(candidate))[0] or "application/octet-stream")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def api_get(self, path: str) -> None:
        parts = [item for item in path.split("/") if item]
        if parts == ["api", "status"]:
            self.send_json({"name": "Nexus OS", "hostname": socket.gethostname(), "local_ips": local_ips(), "servers": [server_view(item) for item in load_servers()]})
            return
        if parts == ["api", "servers"]:
            self.send_json({"servers": [server_view(item) for item in load_servers()]})
            return
        if parts == ["api", "versions"]:
            manifest = fetch_json(MANIFEST_URL)
            self.send_json({"latest": manifest.get("latest", {}), "versions": [item.get("id") for item in manifest.get("versions", [])[:30]]})
            return
        if len(parts) == 4 and parts[0:2] == ["api", "servers"] and parts[3] == "logs":
            server = find_server(load_servers(), parts[2])
            log_path = Path(server["directory"]) / "nexus.log"
            lines = log_path.read_text(encoding="utf-8", errors="replace").splitlines()[-300:] if log_path.exists() else []
            self.send_json({"server": server["id"], "lines": lines})
            return
        if len(parts) == 3 and parts[0:2] == ["api", "servers"]:
            self.send_json(server_view(find_server(load_servers(), parts[2])))
            return
        self.send_error_json("Ruta no disponible.", HTTPStatus.NOT_FOUND)

    def api_post(self, path: str, payload: dict) -> None:
        parts = [item for item in path.split("/") if item]
        if parts == ["api", "servers"]:
            self.send_json(create_server(payload), HTTPStatus.CREATED)
            return
        if len(parts) == 4 and parts[0:2] == ["api", "servers"] and parts[3] in {"start", "stop", "restart", "command", "network"}:
            servers = load_servers()
            server = find_server(servers, parts[2])
            action = parts[3]
            if action == "start":
                result = start_server(server)
            elif action == "stop":
                result = stop_server(server)
            elif action == "restart":
                stop_server(server)
                result = start_server(server)
            elif action == "command":
                command = str(payload.get("command") or "").strip()
                if not command:
                    raise ValueError("Escribe un comando.")
                process = process_for(server["id"])
                if not process or not process.stdin:
                    raise ValueError("El servidor no está iniciado.")
                process.stdin.write(command + "\n")
                process.stdin.flush()
                result = server_view(server)
            else:
                if server_status(server) == "online":
                    raise ValueError("Detén el servidor antes de cambiar su conexión.")
                if "port" in payload:
                    new_port = parse_port(payload["port"])
                    if any(item["id"] != server["id"] and item["port"] == new_port for item in servers):
                        raise ValueError(f"El puerto {new_port} ya está asignado a otro servidor.")
                    server["port"] = new_port
                if "domain" in payload:
                    server["domain"] = clean_domain(payload["domain"])
                update_properties(Path(server["directory"]), {"server-port": str(server["port"])})
                save_servers(servers)
                result = server_view(server)
            self.send_json(result)
            return
        if len(parts) == 3 and parts[0:2] == ["api", "servers"] and parts[2]:
            servers = load_servers()
            server = find_server(servers, parts[2])
            if server_status(server) == "online":
                raise ValueError("Detén el servidor antes de eliminarlo.")
            directory = Path(server["directory"]).resolve()
            if ROOT.resolve() not in directory.parents:
                raise ValueError("La ruta del servidor no es segura.")
            shutil.rmtree(directory)
            servers = [item for item in servers if item["id"] != server["id"]]
            save_servers(servers)
            self.send_json({"deleted": server["id"]})
            return
        self.send_error_json("Ruta no disponible.", HTTPStatus.NOT_FOUND)


def main() -> None:
    ensure_dirs()
    httpd = ThreadingHTTPServer((HOST, PORT), NexusHandler)
    print(f"Nexus OS control plane listening on http://{HOST}:{PORT}", flush=True)
    httpd.serve_forever()


if __name__ == "__main__":
    main()
