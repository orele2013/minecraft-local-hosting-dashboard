#!/usr/bin/env bash
set -euo pipefail

install -d -m 0755 /srv/minecraft /etc/nexus /etc/systemd/system/multi-user.target.wants
install -d -m 0755 /home/nexus/Desktop

useradd --create-home --shell /bin/bash --groups audio,video,plugdev,sudo nexus 2>/dev/null || true
printf 'nexus ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/nexus
chmod 0440 /etc/sudoers.d/nexus

ln -sf /etc/systemd/system/nexus-control.service /etc/systemd/system/multi-user.target.wants/nexus-control.service
cp /usr/share/applications/nexus-control.desktop /home/nexus/Desktop/Nexus-Control.desktop
chown -R nexus:nexus /home/nexus/Desktop
chmod +x /usr/local/bin/nexus-control /usr/local/bin/nexus-minecraft-server

printf '%s\n' 'Nexus OS Preview is ready.' > /etc/nexus/first-boot.txt
