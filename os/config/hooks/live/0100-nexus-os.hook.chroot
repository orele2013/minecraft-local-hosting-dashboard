#!/usr/bin/env bash
set -euo pipefail

install -d -m 0755 /srv/minecraft /var/lib/nexus /etc/nexus /etc/systemd/system/multi-user.target.wants

useradd --create-home --shell /bin/bash --groups audio,video,plugdev,sudo nexus 2>/dev/null || true
passwd --delete nexus >/dev/null 2>&1 || true

if command -v systemctl >/dev/null 2>&1; then
  systemctl enable qemu-guest-agent.service >/dev/null 2>&1 || true
fi

# Keep autologin explicit in LightDM's main configuration as well as in the
# drop-in. live-config may not rewrite the commented defaults on every live
# boot, while LightDM always reads this seat configuration.
if [ -f /etc/lightdm/lightdm.conf ]; then
  sed -i -E \
    -e 's/^#autologin-user=.*/autologin-user=nexus/' \
    -e 's/^#autologin-user-timeout=.*/autologin-user-timeout=0/' \
    -e 's/^#autologin-session=.*/autologin-session=nexus/' \
    /etc/lightdm/lightdm.conf
fi

# The live session is intentionally passwordless. LightDM's autologin PAM
# stack must not reject it because the temporary boot environment exposes
# pam_nologin while the system reaches the graphical target.
if [ -f /etc/pam.d/lightdm-autologin ]; then
  sed -i -E \
    -e '/pam_nologin\.so/d' \
    -e '/pam_succeed_if\.so user != root/d' \
    /etc/pam.d/lightdm-autologin
fi
printf 'nexus ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/nexus
chmod 0440 /etc/sudoers.d/nexus

ln -sf /etc/systemd/system/nexus-control.service /etc/systemd/system/multi-user.target.wants/nexus-control.service
chown -R nexus:nexus /home/nexus /srv/minecraft /var/lib/nexus
chmod +x /usr/local/bin/nexus-control /usr/local/bin/nexus-control-server /usr/local/bin/nexus-kiosk /usr/local/bin/nexus-minecraft-server
